# Run scripts/prepare_runtime.py on the dedicated Linux Docker host first.
# This example contains no credentials. Secret files live in .private/.
APP_MODE=local
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8769,http://localhost:8769,http://127.0.0.1:8080
APP_REVISION=development
WEB_PORT=8080
